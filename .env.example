# 📚 LivroAI - TEMPLATE DE AMBIENTES

# ============================================================================
# 🔐 CREDENCIAIS OBRIGATÓRIAS (preencha antes de rodar)
# ============================================================================

# Supabase (https://supabase.com)
# 1. Crie um projeto novo
# 2. Copie URL e chaves de settings/api
DATABASE_URL=postgresql://postgres:[password]@[project].supabase.co:5432/postgres
SUPABASE_URL=https://[project].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Hugging Face (para YOLO Space)
# 1. Crie um Space com código YOLO (ou use um público)
# 2. Copie URL do API e seu token HF
HF_SPACE_URL=https://huggingface.co/spaces/seu-usuario/seu-space/api
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Google Cloud (Vision + Books)
# Vision: buscador de imagens [Google Cloud Console → APIs & Services → Credentials]
# Books: https://developers.google.com/books/docs/v1/get-started
GOOGLE_VISION_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_BOOKS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral API (LLM)
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# 🔧 CONFIGURAÇÕES (opcionais - têm valores padrão)
# ============================================================================

# Aplicação
APP_ENV=development                    # development | production
APP_NAME=LivroAI
DEBUG=true                             # Habilita /docs em desenvolvimento
PORT=8000
API_PREFIX=/api/v1

# Supabase Storage
STORAGE_BUCKET=Pratileiras             # Bucket para fotos
STORAGE_BUCKET_FOTOS=Pratileiras

# YOLO
YOLO_CONFIDENCE_THRESHOLD=0.6

# CORS (especifique seus domínios)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Regex para aceitar múltiplos subdomínios (ex: vercel preview branches)
ALLOWED_ORIGIN_REGEX=^https://([a-zA-Z0-9-]+\.)*vercel\.app$|^http://localhost(:\d+)?$

# ============================================================================
# 🌐 FRONTEND (apenas se rodar sem Docker)
# ============================================================================

# URL da API (deixe vazio para usar /api/v1 relativo)
VITE_API_URL=http://localhost:8000

# ============================================================================
# 💾 BANCO DE DADOS (apenas para testes locais)
# ============================================================================

# Se quiser rodar PostgreSQL em Docker localmente:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=senha123
# POSTGRES_DB=livroai

# ============================================================================
# 🐛 DEBUG (apenas desenvolvimento)
# ============================================================================

# Defina como true para ver logs detalhados e ter acesso a /docs
DEBUG=true

# ============================================================================
# ⚠️ INSTRUÇÕES
# ============================================================================
#
# 1. Copie este arquivo:
#    cp .env.example .env
#
# 2. Edite .env com suas credenciais reais
#
# 3. NUNCA commita .env no Git!
#    (.gitignore já está configurado)
#
# 4. Para desenvolvimento local, todos os valores acima são suficientes
#
# 5. Para produção (Vercel), configure as variáveis via:
#    - Vercel Dashboard → Settings → Environment Variables
#    - CLI: vercel env add VAR_NAME
#
# 6. Se tiver erro de autenticação, verifique:
#    - API keys estão corretas (sem espaços em branco)
#    - Chaves não têm vencimento
#    - Permissões corretas no Google Cloud
#    - HF token tem direitos de leitura
#
# ============================================================================
